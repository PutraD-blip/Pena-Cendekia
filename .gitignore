**/node_modules/
**/.env
**/.env.backup
**/.env.production
**/storage/*.key
**/storage/logs/*.log
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/public/hot
**/public/storage

# General OS & Editor Ignored Files
.DS_Store
Thumbs.db
*.log
