<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutShelfBookDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    tools:context=".ShelfBookDetailActivity">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/toolbarShelfDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBackShelfDetail"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="4dp"
            android:src="@drawable/ic_back"
            app:tint="@color/primary_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btnBackShelfDetail"
            android:text="Detail buku"
            android:textColor="@color/primary_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnFavoriteShelfDetail"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorit"
            android:padding="4dp"
            android:src="@drawable/ic_heart_outline"
            app:tint="@color/primary_green" />

    </RelativeLayout>

    <!-- Bottom Navigation Bar (Rak Saya Selected) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationShelfDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_cream"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_shelf_menu" />

    <!-- Content Scrollable View -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigationShelfDetail"
        android:layout_below="@id/toolbarShelfDetail"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp">

            <!-- Top Header Book Info Container Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#EEF3EF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Book Cover -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="105dp"
                        android:layout_height="146dp"
                        app:cardBackgroundColor="@color/card_cream"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/ivShelfDetailCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Cover Book"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_digitalisasi_cover" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Book Meta Details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvShelfDetailCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Agama - Studi Islam"
                            android:textColor="@color/primary_green"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvShelfDetailTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:text="DIGITALISASI PENDIDIKAN ISLAM"
                            android:textColor="@color/primary_green"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvShelfDetailAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Dr. Hj. Siti Yumnah, M.Pd.I. Muhammad Sulaiman..."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvShelfDetailRating"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="★ 4,8 · 96 ulasan"
                            android:textColor="#B87B2B"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Sinopsis Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Sinopsis"
                android:textColor="@color/primary_green"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShelfDetailSynopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="5sp"
                android:text="Panduan komprehensif transformasi pendidikan Islam di era digital. Buku ini mengupas kepemimpinan digital, kurikulum adaptif, media pembelajaran interaktif, tata kelola berbasis teknologi, serta penjaminan mutu di berbagai jenjang pendidikan tanpa mengesampingkan nilai-nilai keislaman."
                android:textColor="@color/text_dark"
                android:textSize="13.5sp" />

            <!-- Publisher & Page Info -->
            <TextView
                android:id="@+id/tvShelfDetailPublisher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pena Cendekia · 2026 · 236 halaman"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- ISBN & Favorite Line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvShelfDetailIsbn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_mono"
                    android:text="ISBN 978-623-90010-6-3"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Favorit"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dalam favorit"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Sesi Baca Aktif Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#F7EFE0"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="Sesi Baca Aktif"
                            android:textColor="@color/text_muted"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="Clock"
                            android:src="@drawable/ic_clock"
                            app:tint="#B87B2B" />

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvActiveSessionTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="14 Jam 32 Menit Tersisa"
                        android:textColor="@color/primary_green"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Notification Banner Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotifyBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#E8F2EC"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Notifikasi"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/primary_green" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Kami akan memberi notifikasi saat Sesi Baca-mu Tersisa 1 Jam."
                        android:textColor="@color/primary_green"
                        android:textSize="12.5sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Action Button: Lanjut Membaca -->
            <Button
                android:id="@+id/btnActionReadShelf"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="@color/primary_green"
                android:drawableStart="@drawable/ic_book_open"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Lanjut membaca"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
