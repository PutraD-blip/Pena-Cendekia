<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lora"
        android:text="Masuk Akun Penulis"
        android:textColor="@color/primary_green"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/inter"
        android:text="Gunakan akun terdaftar di portal web Pena Cendekia"
        android:textColor="@color/text_muted"
        android:textSize="12.5sp" />

    <!-- Email Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/inter"
        android:text="Email Penulis"
        android:textColor="@color/text_dark"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etLoginEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_filter_box"
        android:fontFamily="@font/inter"
        android:hint="budi@test.com"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:text="budi@test.com"
        android:textColor="@color/text_dark"
        android:textSize="13.5sp" />

    <!-- Password Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/inter"
        android:text="Kata Sandi"
        android:textColor="@color/text_dark"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etLoginPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_filter_box"
        android:fontFamily="@font/inter"
        android:hint="author123"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:text="author123"
        android:textColor="@color/text_dark"
        android:textSize="13.5sp" />

    <!-- Lupa Kata Sandi Link -->
    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter"
        android:padding="4dp"
        android:text="Lupa kata sandi?"
        android:textColor="@color/accent_gold"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Button Submit -->
    <Button
        android:id="@+id/btnSubmitLogin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="@color/primary_green"
        android:fontFamily="@font/inter"
        android:text="Masuk ke Akun"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <!-- Belum punya akun link -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="Belum punya akun? "
            android:textColor="@color/text_muted"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/tvRegisterLinkDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter"
            android:padding="2dp"
            android:text="Daftar di sini"
            android:textColor="@color/primary_green"
            android:textSize="12.5sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
