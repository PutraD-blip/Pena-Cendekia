<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lora"
        android:text="Lupa Kata Sandi"
        android:textColor="@color/primary_green"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:fontFamily="@font/inter"
        android:text="Masukkan email terdaftar Anda dan buat kata sandi baru."
        android:textColor="@color/text_muted"
        android:textSize="12.5sp" />

    <!-- Email Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/inter"
        android:text="Email Terdaftar"
        android:textColor="@color/text_dark"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etForgotEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_filter_box"
        android:fontFamily="@font/inter"
        android:hint="nama@email.com"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_dark"
        android:textSize="13.5sp" />

    <!-- New Password Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/inter"
        android:text="Kata Sandi Baru"
        android:textColor="@color/text_dark"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etForgotNewPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_filter_box"
        android:fontFamily="@font/inter"
        android:hint="Minimal 6 karakter"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_dark"
        android:textSize="13.5sp" />

    <!-- Confirm Password Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/inter"
        android:text="Konfirmasi Kata Sandi"
        android:textColor="@color/text_dark"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etForgotConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_filter_box"
        android:fontFamily="@font/inter"
        android:hint="Ulangi kata sandi baru"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_dark"
        android:textSize="13.5sp" />

    <!-- Button Submit -->
    <Button
        android:id="@+id/btnSubmitForgotPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="@color/primary_green"
        android:fontFamily="@font/inter"
        android:text="Perbarui Kata Sandi"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

</LinearLayout>
