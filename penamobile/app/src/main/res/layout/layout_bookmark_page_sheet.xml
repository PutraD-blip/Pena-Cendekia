<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Icon Badge -->
    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circle_icon_badge"
        android:gravity="center">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Penanda"
            android:src="@drawable/ic_bookmark_check"
            app:tint="@color/primary_green" />

    </LinearLayout>

    <!-- Title & Subtitle -->
    <TextView
        android:id="@+id/tvBookmarkSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lora"
        android:gravity="center"
        android:text="Tandai Halaman Ini?"
        android:textColor="@color/primary_green"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBookmarkSheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="Asuhan Kebidanan Pada Kehamilan"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Info Explanation Box -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/bg_light_green"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline_green"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌"
                android:textSize="20sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvBookmarkSheetDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="Halaman ini akan dicatat sebagai halaman terakhir yang Anda baca. Saat membuka Rak Buku, tombol 'Lanjut Membaca' akan otomatis meluncurkan Anda ke halaman ini."
                android:textColor="@color/text_dark"
                android:textSize="12.5sp"
                android:lineSpacingExtra="3sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Action Button: Tandai Sebagai Terakhir Baca -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSetLastReadBookmark"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fontFamily="@font/inter"
        android:text="📌 Tandai Sebagai Terakhir Baca"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_green"
        app:cornerRadius="12dp" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelBookmarkSheet"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter"
        android:text="Batal (Ketuk di luar untuk menutup)"
        android:textAllCaps="false"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

</LinearLayout>
