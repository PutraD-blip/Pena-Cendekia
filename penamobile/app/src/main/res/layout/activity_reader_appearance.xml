<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutAppearanceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181E1B"
    tools:context=".ReaderAppearanceActivity">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/toolbarAppearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBackAppearance"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="4dp"
            android:src="@drawable/ic_back"
            app:tint="#A7D7C5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBookTitleAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Asuhan Kebidanan Pada Kehamilan"
                android:textColor="#A7D7C5"
                android:textSize="17sp"
                android:fontFamily="@font/lora"
                app:fontFamily="@font/lora"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitleAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tema Gelap"
                android:textColor="#8E9F97"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                app:fontFamily="@font/inter" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnBookmarkAppearance"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bookmark"
            android:padding="4dp"
            android:src="@drawable/ic_bookmark_check"
            app:tint="#A7D7C5" />

    </LinearLayout>

    <!-- Real PDF Page Preview Container -->
    <FrameLayout
        android:id="@+id/layoutPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/cardAppearanceSheet"
        android:layout_below="@id/toolbarAppearance"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPdfPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/divider_color"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivAppearancePdfPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="Pratinjau Halaman Naskah"
                android:scaleType="fitCenter" />

            <!-- Loading indicator for preview render -->
            <ProgressBar
                android:id="@+id/pbPreviewLoading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary_green"
                android:visibility="gone" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Tampilan Baca Bottom Sheet Container Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAppearanceSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Sheet Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvSheetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Tampilan Baca"
                    android:textColor="#203C32"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDoneAppearance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    android:text="Selesai"
                    android:textColor="@color/primary_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Section: Tema layar (Terang, Gelap, Sepia) -->
            <TextView
                android:id="@+id/tvSectionScreenTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Tema layar"
                android:textColor="#203C32"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Theme 1: Terang (Light) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardThemeTerang"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#F8F6EF"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAaTerang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aa"
                            android:textColor="#203C32"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLabelTerang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Terang"
                            android:textColor="#203C32"
                            android:textSize="11.5sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Theme 2: Gelap (Dark) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardThemeGelap"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#222B26"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/primary_green"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAaGelap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aa"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLabelGelap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="✓ Gelap"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Theme 3: Sepia -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardThemeSepia"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#EFE2C9"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAaSepia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aa"
                            android:textColor="#584A35"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLabelSepia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Sepia"
                            android:textColor="#584A35"
                            android:textSize="11.5sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Bottom Note -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preferensi tema disimpan otomatis untuk bacaan berikutnya."
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
