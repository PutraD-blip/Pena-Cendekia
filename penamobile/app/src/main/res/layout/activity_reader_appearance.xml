<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutAppearanceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4E8D3"
    tools:context=".ReaderAppearanceActivity">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/toolbarAppearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBackAppearance"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="4dp"
            android:src="@drawable/ic_back"
            app:tint="#203C32" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBookTitleAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Digitalisasi Pendidikan Islam"
                android:textColor="#203C32"
                android:textSize="18sp"
                android:fontFamily="@font/lora"
                app:fontFamily="@font/lora"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitleAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Pratinjau tema sepia · halaman 42"
                android:textColor="#556B60"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                app:fontFamily="@font/inter" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnBookmarkAppearance"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bookmark"
            android:padding="4dp"
            android:src="@drawable/ic_bookmark_check"
            app:tint="#203C32" />

    </LinearLayout>

    <!-- Tampilan Baca Bottom Sheet Container Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAppearanceSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Sheet Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvSheetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Tampilan Baca"
                    android:textColor="#203C32"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDoneAppearance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="Selesai"
                    android:textColor="#203C32"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Section 1: Ukuran teks -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvSectionTextSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Ukuran teks"
                    android:textColor="#203C32"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFontSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="18 px"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekBarFontSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="20"
                    android:progress="6"
                    android:progressTint="#203C32"
                    android:thumbTint="#203C32" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textColor="#203C32"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="@color/divider_color" />

            <!-- Section 3: Tema layar -->
            <TextView
                android:id="@+id/tvSectionScreenTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Tema layar"
                android:textColor="#203C32"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Theme 1: Terang (Light) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardThemeTerang"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#F8F6EF"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAaTerang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aa"
                            android:textColor="#203C32"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLabelTerang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Terang"
                            android:textColor="#203C32"
                            android:textSize="11.5sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Theme 2: Gelap (Dark) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardThemeGelap"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#222B26"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#222B26"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAaGelap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aa"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLabelGelap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Gelap"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Theme 3: Sepia (Selected) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardThemeSepia"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#EFE2C9"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#203C32"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAaSepia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aa"
                            android:textColor="#584A35"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLabelSepia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="✓ Sepia"
                            android:textColor="#584A35"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Bottom Note -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preferensi disimpan otomatis untuk bacaan berikutnya."
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Reading Content Scroll View -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewAppearance"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/cardAppearanceSheet"
        android:layout_below="@id/toolbarAppearance"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        android:fillViewport="true"
        android:isScrollContainer="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp">

            <!-- Chapter Title: Strategi Perumusan Visi Lembaga -->
            <TextView
                android:id="@+id/tvChapterTitleAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Strategi Perumusan Visi Lembaga"
                android:textColor="#203C32"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Paragraph 1 -->
            <TextView
                android:id="@+id/tvParagraphAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:lineSpacingExtra="6sp"
                android:text="Pengembangan lembaga pendidikan Islam yang unggul membutuhkan landasan kepemimpinan yang berorientasi pada masa depan. Seorang pemimpin visioner tidak hanya bertugas merumuskan arah strategis, tetapi juga harus mampu mengintegrasikan nilai-nilai keislaman ke dalam seluruh ekosistem organisasi."
                android:textColor="#203C32"
                android:textSize="15sp" />

            <!-- Page Number Center Line -->
            <TextView
                android:id="@+id/tvPageCenterAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="12dp"
                android:gravity="center"
                android:text="42 / 240 halaman"
                android:textColor="#7A6A55"
                android:textSize="12.5sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
