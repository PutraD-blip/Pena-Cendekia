<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeColor="#E6E9E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="24dp">

        <!-- Header Badge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/bg_light_green"
            app:cardCornerRadius="27dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline_green"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Edit Profil"
                android:src="@drawable/ic_user_round"
                app:tint="@color/primary_green" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Title & Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lora"
            android:gravity="center"
            android:text="Edit Profil Pengguna"
            android:textColor="@color/primary_green"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="Perbarui informasi profil dan kontak akun Anda."
            android:textColor="@color/text_muted"
            android:textSize="12.5sp" />

        <!-- Field 1: Nama Lengkap -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter"
            android:text="Nama Lengkap"
            android:textColor="@color/primary_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditProfileName"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/inter"
            android:hint="Nama Lengkap"
            android:inputType="textPersonName"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="13.5sp" />

        <!-- Field 2: Email Akun -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter"
            android:text="Email Akun"
            android:textColor="@color/primary_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/inter"
            android:hint="alamat@email.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="13.5sp" />

        <!-- Field 3: Nomor Telepon / WhatsApp -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter"
            android:text="Nomor Telepon / WhatsApp"
            android:textColor="@color/primary_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/inter"
            android:hint="08xxxxxxxxxx"
            android:inputType="phone"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="13.5sp" />

        <!-- Action Button: Simpan Perubahan -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEditProfile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/primary_green"
            android:fontFamily="@font/inter"
            android:text="Simpan Perubahan"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEditProfile"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter"
            android:text="Batal"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="13.5sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
