<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeColor="#E6E9E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="24dp">

        <!-- Top Badge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/bg_light_green"
            app:cardCornerRadius="27dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline_green"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Ubah Sandi"
                android:src="@drawable/ic_lock_keyhole"
                app:tint="@color/primary_green" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Title & Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lora"
            android:gravity="center"
            android:text="Ubah Kata Sandi"
            android:textColor="@color/primary_green"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="Gunakan minimal 6 karakter untuk menjaga keamanan akun."
            android:textColor="@color/text_muted"
            android:textSize="12.5sp" />

        <!-- Field 1: Kata Sandi Saat Ini -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter"
            android:text="Kata Sandi Saat Ini"
            android:textColor="@color/primary_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOldPassword"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/inter"
            android:hint="Masukkan kata sandi lama"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="13.5sp" />

        <!-- Field 2: Kata Sandi Baru -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter"
            android:text="Kata Sandi Baru"
            android:textColor="@color/primary_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/inter"
            android:hint="Minimal 6 karakter"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="13.5sp" />

        <!-- Field 3: Konfirmasi Kata Sandi Baru -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter"
            android:text="Konfirmasi Kata Sandi Baru"
            android:textColor="@color/primary_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/inter"
            android:hint="Ulangi kata sandi baru"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_muted"
            android:textSize="13.5sp" />

        <!-- Button Simpan -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/primary_green"
            android:fontFamily="@font/inter"
            android:text="Simpan Kata Sandi"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- Button Batal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPassword"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter"
            android:text="Batal"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="13.5sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
