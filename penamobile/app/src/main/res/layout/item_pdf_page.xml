<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPdfPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="6dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/divider_color"
        app:strokeWidth="1dp">

        <com.example.penacendekia.ZoomableImageView
            android:id="@+id/ivPdfPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="Halaman E-Book"
            android:minHeight="400dp" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvPdfPageNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter"
        android:text="— Halaman 1 —"
        android:textColor="@color/text_muted"
        android:textSize="11.5sp" />

</LinearLayout>
